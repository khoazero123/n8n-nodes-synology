{
	"name": "n8n-nodes-synology",
	"version": "0.1.5",
	"description": "n8n community nodes for Synology NAS applications",
	"keywords": [
		"n8n-community-node-package",
		"synology",
		"synology-nas",
		"synology-note-station",
		"synology-drive",
		"synology-download-station"
	],
	"license": "MIT",
	"homepage": "https://github.com/khoazero123/n8n-nodes-synology",
	"author": {
		"name": "KhoaZero123",
		"email": "khoazero123@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/khoazero123/n8n-nodes-synology.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build && node scripts/bundle.mjs",
		"build:dev": "npm run build && node scripts/n8n-reload.mjs reload",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"n8n:start": "node scripts/n8n-reload.mjs start",
		"n8n:reload": "node scripts/n8n-reload.mjs reload",
		"n8n:stop": "node scripts/n8n-reload.mjs stop",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SynologyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SynologyNoteStation/SynologyNoteStation.node.js",
			"dist/nodes/SynologyDrive/SynologyDrive.node.js",
			"dist/nodes/SynologyDownloadStation/SynologyDownloadStation.node.js",
			"dist/nodes/SynologyMailPlusClient/SynologyMailPlusClient.node.js",
			"dist/nodes/SynologyMailPlusClient/SynologyMailPlusClientTrigger.node.js",
			"dist/nodes/SynologyChat/SynologyChat.node.js",
			"dist/nodes/SynologyChat/SynologyChatTrigger.node.js",
			"dist/nodes/SynologyPhotos/SynologyPhotos.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^24.2.1",
		"esbuild": "^0.28.1",
		"eslint": "9.39.5",
		"prettier": "3.9.6",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
